# Copy to .env and adjust as needed. Never commit real secrets.
APP_NAME=OnboardIQ API
# "production" turns on strict checks: the API refuses to start without a strong JWT_SECRET_KEY,
# COOKIE_SECURE=true, and with demo accounts using the default password.
ENVIRONMENT=development
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# Database (SQLAlchemy URL)
# Leave unset to use a local SQLite file (backend/onboardiq.db) - no installation needed.
# PostgreSQL (primary database):
# DATABASE_URL=postgresql+psycopg://onboardiq:change_me@localhost:5432/onboardiq
# Database schema changes are applied automatically on startup (Alembic migrations in backend/migrations).

# Create the fictional demo accounts (1 HR user, 9 employees) and their checklists on startup if missing.
# Existing users and progress are never overwritten. Set false in production.
SEED_DEMO_DATA=true

# Authentication
# Secret used to sign session tokens (at least 32 random characters). Required in production. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Leave unset in development: a random secret is generated once and stored in backend/storage/ (gitignored).
# JWT_SECRET_KEY=
# Session length in minutes (default 8 hours)
ACCESS_TOKEN_EXPIRE_MINUTES=480
# Send the session cookie over HTTPS only. Must be true in production.
COOKIE_SECURE=false
# Password of the seeded demo accounts (local development only; change it or disable seeding elsewhere).
# DEMO_USER_PASSWORD=
# Failed sign-ins allowed per email + client before a temporary lockout
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15
# Public employee sign-up at /register (always creates Employee accounts, never HR). Set false to manage accounts centrally.
ALLOW_SELF_REGISTRATION=true
# Sign-up attempts allowed per client address per hour
REGISTRATION_MAX_PER_HOUR=10
# Password reset
# Where the frontend runs; reset emails link to <FRONTEND_BASE_URL>/reset-password?token=...
FRONTEND_BASE_URL=http://localhost:5173
# Reset links expire after this many minutes and work once
PASSWORD_RESET_MINUTES=30
# Reset requests allowed per email + client per hour
PASSWORD_RESET_MAX_PER_HOUR=5

# Outgoing email (password reset links)
# "file" (default, for local development) writes each email as an .eml file to MAIL_OUTBOX_DIR
# (default backend/storage/outbox, gitignored) and logs its path - nothing is sent.
# "smtp" sends through your mail server (SMTP_HOST is required).
MAIL_BACKEND=file
MAIL_FROM=OnboardIQ <no-reply@onboardiq-demo.example>
# MAIL_OUTBOX_DIR=storage/outbox
# SMTP_HOST=smtp.example.com
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_STARTTLS=true

# Onboarding task uploads (identity documents etc.): PDF, JPG or PNG only
# EMPLOYEE_DOCUMENTS_DIR=storage/employee-documents
EMPLOYEE_DOCUMENT_MAX_MB=5
# Key that encrypts bank account numbers at rest (Fernet). Required in production; keep it safe -
# losing it makes saved account numbers unreadable. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Leave unset in development: a key is generated once and stored in backend/storage/ (gitignored).
# DATA_ENCRYPTION_KEY=

# Profile photos (JPG/PNG, validated, resized and stripped of metadata) and Help Desk attachments (PNG/JPG/PDF)
# PROFILE_PHOTOS_DIR=storage/profile-photos
PROFILE_PHOTO_MAX_MB=2
# HELPDESK_ATTACHMENTS_DIR=storage/helpdesk
HELPDESK_ATTACHMENT_MAX_MB=5

# Work calendar: weekly days off (JSON list) and the company holiday file. Due dates never fall on these days,
# and the onboarding calendar explains them. Edit app/data/company_holidays.json to match your HR holiday list.
WEEKLY_OFF_DAYS=["saturday","sunday"]
# COMPANY_HOLIDAYS_FILE=app/data/company_holidays.json

# Policy understanding quizzes: percentage needed to pass (80 = 4 of 5 questions)
POLICY_QUIZ_PASS_PERCENT=80

# Interactive API docs at /docs and /redoc
ENABLE_API_DOCS=true

# Policy documents
# Folder for uploaded files and the FAISS index (default: backend/storage/policies)
# POLICY_STORAGE_DIR=storage/policies
POLICY_MAX_UPLOAD_MB=10
# Chunk size and overlap in characters
POLICY_CHUNK_SIZE=500
POLICY_CHUNK_OVERLAP=100
# "sentence-transformers" for semantic search, or "hashing" (keyword-based, no download) for offline use
EMBEDDING_PROVIDER=sentence-transformers
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# Policy Assistant (LLM). Any OpenAI-compatible Chat Completions API works.
# Without LLM_API_KEY the assistant reports that it isn't configured (it never makes up answers).
# OpenAI:
# LLM_API_KEY=sk-...
# LLM_MODEL=gpt-4o-mini
# LLM_BASE_URL=https://api.openai.com/v1
# Local Ollama (free, no key needed - any non-empty value works):
# LLM_API_KEY=ollama
# LLM_MODEL=llama3.1:8b
# LLM_BASE_URL=http://localhost:11434/v1
# Time budget for one answer (also the longest wait for the next streamed piece). On a CPU-only machine a local
# model can need 60-90 s; answers are streamed to the browser, so employees see text before it finishes.
LLM_TIMEOUT_SECONDS=45
LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=600
# Local servers only (Ollama): keep the model loaded this long after a question (Ollama's default is 5 minutes, after
# which the next question waits for a reload). Never sent to hosted APIs.
LLM_KEEP_ALIVE=30m
# Load the embedding model and (for a local LLM server) the LLM in the background at startup, so the first question
# doesn't wait for them. Each running API instance loads its own copy of the embedding model (~500 MB of RAM).
WARM_UP_MODELS=true
# API log level. INFO includes one "Policy chat timings" line per question (embedding, FAISS, database, context,
# first token, generation, validation and total times).
LOG_LEVEL=INFO
# Retrieval for the assistant: passages per answer and similarity thresholds (tuned for all-MiniLM-L6-v2)
RAG_TOP_K=5
RAG_MIN_RELEVANCE=0.30
RAG_STRONG_RELEVANCE=0.55

# Fixed "today" for the demo onboarding data (matches the frontend demo date). Remove to use the real date.
REFERENCE_DATE=2026-11-07
