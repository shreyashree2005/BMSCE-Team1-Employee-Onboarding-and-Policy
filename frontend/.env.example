# Base URL of the OnboardIQ FastAPI backend. Use the same site as the frontend (e.g. localhost for both)
# so the session cookie is sent. These values are compiled into the browser bundle: never put secrets here.
VITE_API_BASE_URL=http://localhost:8000

# Fixed "today" for due-date calculations; keep in sync with the backend's REFERENCE_DATE.
VITE_REFERENCE_DATE=2026-11-07

# List the fictional demo accounts (emails only) on the sign-in page. Defaults to true in dev, false in builds.
# VITE_SHOW_DEMO_ACCOUNTS=false
